# AWS EC2 + Apache Web Server + HTML Hosting Practical

# STEP 1 — Connect to EC2 Instance
ssh -i your-key.pem ec2-user@your-public-ip


# STEP 2 — Install Apache Web Server
sudo dnf install httpd -y


# STEP 3 — Start Apache Server
sudo systemctl start httpd


# STEP 4 — Enable Apache on System Boot
sudo systemctl enable httpd


# STEP 5 — Check Apache Status
sudo systemctl status httpd


# STEP 6 — Move to Apache Web Directory
cd /var/www/html


# STEP 7 — Create HTML File
sudo nano index.html


# STEP 8 — Paste HTML Code

<!DOCTYPE html>
<html>
<head>
    <title>Cloud Computing Practical</title>
</head>

<body style="text-align:center; font-family:Arial;">

    <h1>Welcome to My AWS EC2 Server</h1>

    <h2>Cloud Computing Practical</h2>

    <p>Hosted using Apache Web Server on AWS EC2 Instance.</p>

</body>
</html>


# STEP 9 — Save File in Nano Editor
CTRL + O
ENTER
CTRL + X


# STEP 10 — Restart Apache Server
sudo systemctl restart httpd


# STEP 11 — Open Browser
http://your-public-ip


# OPTIONAL COMMANDS

# Check Current Directory
pwd

# List Files
ls

# View HTML File Contents
cat /var/www/html/index.html

# Check Apache Configuration
cat /etc/httpd/conf/httpd.conf


# IMPORTANT NOTES

# Apache Document Root:
/var/www/html

# Default Webpage File:
index.html

# Security Group Inbound Rule Required:
HTTP -> Port 80 -> 0.0.0.0/0


# OUTPUT

The webpage displays:

Welcome to My AWS EC2 Server
Cloud Computing Practical
Hosted using Apache Web Server on AWS EC2 Instance.
